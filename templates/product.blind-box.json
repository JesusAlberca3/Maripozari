{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "mystery": {
          "type": "text",
          "settings": {
            "text": "Caja sellada. Adentro hay un diseño al azar de esta serie.",
            "text_style": "body"
          }
        },
        "icons": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "box",
            "heading_1": "Caja sellada",
            "icon_2": "question_mark",
            "heading_2": "Diseño sorpresa",
            "icon_3": "truck",
            "heading_3": "El envío se calcula al pagar"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "tab_sorpresa": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "La sorpresa",
            "icon": "question_mark",
            "content": "<p>No se elige el personaje. Cada caja trae un diseño de la serie, al azar. Las fotos muestran la línea, no la figura que te va a tocar.</p>"
          }
        },
        "tab_envio": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Envío",
            "icon": "truck",
            "content": "<p>El costo y el plazo aparecen al pagar, según tu dirección. Si llega dañada, escríbenos con fotos del empaque y de la pieza.</p>"
          }
        },
        "tab_cambios": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Cambios",
            "icon": "return",
            "content": "<p>Que salga otro diseño de la misma serie es la sorpresa. Si el empaque llega dañado, lo revisamos con fotos.</p>"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Compartir"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "mystery",
        "icons",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "tab_sorpresa",
        "tab_envio",
        "tab_cambios",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "moment": {
      "type": "maripozari-moment",
      "settings": {
        "image": "butterfly",
        "image_position": "left",
        "heading": "La sorpresa es el diseño",
        "text": "<p>No eliges el personaje. Eliges la serie, y la caja llega cerrada. A veces viene un sticker del bosque, cuando hay stock.</p>",
        "button_label": "Ver más cajas",
        "button_link": "/collections/blind-box"
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Otras cajas",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": true,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": ["main", "moment", "disclosures", "related-products"]
}
