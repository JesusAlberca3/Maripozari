{
  "sections": {
    "intro": {
      "type": "rich-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "@maripo.zari",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Contacto",
            "heading_size": "h0"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Para un pedido, una caja dañada o una feria. Cuéntalo corto: número de pedido si ya compraste, y fotos si algo llegó mal.</p>"
          }
        }
      },
      "block_order": ["caption", "heading", "text"],
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "scheme-1",
        "full_width": true,
        "padding_top": 48,
        "padding_bottom": 0
      }
    },
    "form": {
      "type": "contact-form",
      "settings": {
        "heading": "Escríbenos",
        "heading_size": "h2",
        "color_scheme": "scheme-1",
        "padding_top": 28,
        "padding_bottom": 48
      }
    }
  },
  "order": ["intro", "form"]
}
