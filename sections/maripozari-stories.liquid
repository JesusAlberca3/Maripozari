<script src="{{ 'maripozari-reel.js' | asset_url }}" defer="defer"></script>

<maripozari-reel class="maripozari-reel">
  <div class="page-width maripozari-reel__bar">
    {%- if section.settings.heading != blank -%}
      <h2 class="maripozari-reel__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="maripozari-reel__controls">
      <button type="button" data-reel-dir="-1" aria-label="Anterior">
        <span aria-hidden="true">←</span>
      </button>
      <button type="button" data-reel-dir="1" aria-label="Siguiente">
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
  <div class="maripozari-reel__viewport page-width">
    <div class="maripozari-reel__track" data-reel-track>
      {%- for block in section.blocks -%}
        <article
          class="maripozari-reel__slide maripozari-moment maripozari-moment--{{ block.settings.style }}"
          data-reel-slide
          {% if block.settings.anchor != blank %}
            id="{{ block.settings.anchor | escape }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="maripozari-moment__inner">
            <div class="maripozari-moment__media">
              {% render 'maripozari-creature', name: block.settings.image, width: 180 %}
            </div>
            <div>
              {%- if block.settings.heading != blank -%}
                <h2 class="maripozari-moment__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="maripozari-moment__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a class="button button--secondary" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
                  {{ block.settings.button_label }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</maripozari-reel>

{% schema %}
{
  "name": "Carrusel de secciones",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "La tienda"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Sección",
      "settings": [
        {
          "type": "text",
          "id": "anchor",
          "label": "Ancla"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Estilo",
          "options": [
            { "value": "paper", "label": "Blanco" },
            { "value": "ink", "label": "Negro" },
            { "value": "frame", "label": "Marco" },
            { "value": "center", "label": "Centrado" }
          ],
          "default": "paper"
        },
        {
          "type": "select",
          "id": "image",
          "label": "Ilustración",
          "options": [
            { "value": "butterfly", "label": "Mariposa" },
            { "value": "hat", "label": "Sombrero" },
            { "value": "mushroom", "label": "Hongo" },
            { "value": "flower", "label": "Flor" },
            { "value": "frog", "label": "Rana" },
            { "value": "mountain", "label": "Montaña" },
            { "value": "leaf", "label": "Hoja" },
            { "value": "sprout", "label": "Brote" },
            { "value": "antler", "label": "Astas" },
            { "value": "branch", "label": "Rama" }
          ],
          "default": "antler"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Blind box"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Eliges la serie, no el personaje.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Botón"
        },
        {
          "type": "text",
          "id": "button_link",
          "label": "Ruta del botón"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carrusel de secciones"
    }
  ]
}
{% endschema %}
