<section class="maripozari-banner">
  <div class="page-width">
    <div class="maripozari-banner__panel">
      <div class="maripozari-banner__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="maripozari-banner__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="maripozari-banner__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="maripozari-banner__text">{{ section.settings.text }}</p>
        {%- endif -%}
        <div class="maripozari-banner__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="button button--secondary" href="{{ section.settings.button_link_2 | default: routes.root_url }}">
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>
      </div>
      <div class="maripozari-banner__visual">
        {%- if section.settings.visual == 'creature' -%}
          <img
            src="{{ 'creature-hat.png' | asset_url }}"
            width="280"
            height="214"
            alt=""
          >
        {%- elsif section.settings.visual == 'symbol' -%}
          <img
            src="{{ 'logo-symbol.png' | asset_url }}"
            width="220"
            height="234"
            alt="{{ shop.name | escape }}"
          >
        {%- else -%}
          <img
            src="{{ 'logo-original.png' | asset_url }}"
            width="280"
            height="322"
            alt="{{ shop.name | escape }}"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner Maripozari",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Coleccionables"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Abre cuando quieras"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Blind box y figuras. Tú eliges la serie. Si la caja está sellada, el personaje espera adentro."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Ver cajas"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Ruta del botón",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Segundo botón",
      "default": "Cómo funciona"
    },
    {
      "type": "text",
      "id": "button_link_2",
      "label": "Ruta del segundo botón",
      "default": "/pages/como-funciona"
    },
    {
      "type": "select",
      "id": "visual",
      "label": "Imagen",
      "options": [
        { "value": "logo", "label": "Logo original" },
        { "value": "symbol", "label": "Símbolo" },
        { "value": "creature", "label": "Criatura" }
      ],
      "default": "logo"
    }
  ],
  "presets": [
    {
      "name": "Banner Maripozari"
    }
  ]
}
{% endschema %}
