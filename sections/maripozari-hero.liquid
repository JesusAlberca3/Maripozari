{{ 'maripozari.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="maripozari-hero color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="maripozari-hero__inner">
      {%- if section.settings.show_logo -%}
        <img
          class="maripozari-hero__logo"
          src="{{ 'logo-original.png' | asset_url }}"
          width="220"
          height="253"
          alt="{{ shop.name | escape }}"
        >
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="maripozari-hero__heading maripozari-display">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="maripozari-hero__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="maripozari-hero__actions">
          <a
            class="button{% if section.settings.button_style_secondary %} button--secondary{% endif %}"
            {% if section.settings.button_link == blank %}
              href="{{ routes.all_products_collection_url }}"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
          >
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Maripozari hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Mostrar logo original",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Misterio para coleccionar"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Blind box y figuras con identidad propia. El empaque ya es colorido: la tienda se queda en blanco, negro y gris."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Ver cajas"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "Botón secundario",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Maripozari hero"
    }
  ]
}
{% endschema %}
