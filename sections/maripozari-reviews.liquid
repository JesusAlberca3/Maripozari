<script src="{{ 'maripozari-reel.js' | asset_url }}" defer="defer"></script>

<maripozari-reel class="maripozari-reel maripozari-reviews">
  <div class="page-width maripozari-reel__bar">
    <div>
      {%- if section.settings.heading != blank -%}
        <h2 class="maripozari-reel__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="maripozari-reviews__intro">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    <div class="maripozari-reel__controls">
      <button type="button" data-reel-dir="-1" aria-label="Anterior">
        <span aria-hidden="true">←</span>
      </button>
      <button type="button" data-reel-dir="1" aria-label="Siguiente">
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
  <div class="maripozari-reel__viewport page-width">
    <div class="maripozari-reel__track" data-reel-track>
      {%- if section.blocks.size == 0 -%}
        <article class="maripozari-reviews__card maripozari-reviews__card--empty" data-reel-slide>
          <p class="maripozari-reviews__stars" aria-hidden="true">★★★★★</p>
          <p>Todavía no hay reseñas. Cuando lleguen, aparecen en este carrusel.</p>
        </article>
      {%- else -%}
        {%- for block in section.blocks -%}
          <article class="maripozari-reviews__card" data-reel-slide {{ block.shopify_attributes }}>
            <p class="maripozari-reviews__stars" aria-label="{{ block.settings.stars }} de 5">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.stars -%}★{%- else -%}☆{%- endif -%}
              {%- endfor -%}
            </p>
            {%- if block.settings.quote != blank -%}
              <blockquote>{{ block.settings.quote }}</blockquote>
            {%- endif -%}
            {%- if block.settings.author != blank -%}
              <p class="maripozari-reviews__author">{{ block.settings.author }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</maripozari-reel>

{% schema %}
{
  "name": "Reseñas",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Reseñas"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Prueba del carrusel. Sustituye estos ejemplos cuando haya reseñas reales."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Estrellas",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Texto",
          "default": "La caja llegó sellada. Abrirla fue la mejor parte."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nombre",
          "default": "Ejemplo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reseñas",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
