<script src="{{ 'maripozari-reel.js' | asset_url }}" defer="defer"></script>
<maripozari-reel
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | escape }}"
  {% endif %}
  class="maripozari-steps"
>
  <div class="page-width maripozari-reel__bar">
    {%- if section.settings.heading != blank -%}
      <h2 class="maripozari-steps__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="maripozari-reel__controls">
      <button type="button" data-reel-dir="-1" aria-label="Anterior"><span aria-hidden="true">←</span></button>
      <button type="button" data-reel-dir="1" aria-label="Siguiente"><span aria-hidden="true">→</span></button>
    </div>
  </div>
  <div class="page-width">
    <ol class="maripozari-steps__list" data-reel-track>
      {%- for block in section.blocks -%}
        <li data-reel-slide {{ block.shopify_attributes }}>
          {% render 'maripozari-creature', name: block.settings.image, width: 96 %}
          <span class="maripozari-steps__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</maripozari-reel>

{% schema %}
{
  "name": "Pasos Maripozari",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancla"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Tres momentos"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {
          "type": "select",
          "id": "image",
          "label": "Ilustración",
          "options": [
            { "value": "butterfly", "label": "Mariposa" },
            { "value": "hat", "label": "Sombrero" },
            { "value": "mushroom", "label": "Hongo" },
            { "value": "flower", "label": "Flor" },
            { "value": "frog", "label": "Rana" },
            { "value": "mountain", "label": "Montaña" },
            { "value": "leaf", "label": "Hoja" },
            { "value": "sprout", "label": "Brote" },
            { "value": "antler", "label": "Astas" },
            { "value": "branch", "label": "Rama" }
          ],
          "default": "butterfly"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "La serie"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Eliges la línea."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pasos Maripozari",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
