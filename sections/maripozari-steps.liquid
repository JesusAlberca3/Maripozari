<section class="maripozari-steps">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="maripozari-steps__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ol class="maripozari-steps__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <span class="maripozari-steps__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Pasos Maripozari",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Tres momentos"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "La serie"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Eliges la línea."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pasos Maripozari",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
